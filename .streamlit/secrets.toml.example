# LEA app — secrets template
#
# DO NOT put real values in this file or commit them. This is only a reference
# for what to paste into Streamlit Community Cloud:
#   your app → Manage app → Settings → Secrets
#
# Locally, you normally use the in-app Settings page (which writes a .env)
# instead of this file. On the hosted app, these secrets are how it connects.

# Supabase connection string — Project Settings > Database > Connection string
# > URI, "Session pooler", with [YOUR-PASSWORD] filled in. This is what makes
# data persist across reloads and redeploys.
LEA_DB_URL = "postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-...pooler.supabase.com:5432/postgres"

# AI provider (optional — leave out to run in offline mode).
LEA_LLM_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
LEA_LLM_MODEL = "gemini-flash-latest"
LEA_LLM_API_KEY = "your-provider-key"

# Salt for pseudonymising PII (any long random string). Keep it stable so the
# same person always hashes to the same token.
LEA_PII_SALT = "change-me-to-a-long-random-string"
